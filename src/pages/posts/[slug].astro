---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import { getAllPosts, readingMinutes, toSlug } from '../../lib/posts';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

// 目录优先只取 h2（一篇长文 6–8 条最舒服）；h2 太少时才回退到 h2+h3
const h2s = headings.filter((h) => h.depth === 2);
const toc = h2s.length >= 3 ? h2s : headings.filter((h) => h.depth === 2 || h.depth === 3);

const mins = readingMinutes(post);
const updated = data.updated ?? data.date;

const fmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const dateText = fmt.format(data.date).replace(/\//g, '-');
const updatedText = fmt.format(updated).replace(/\//g, '-');

// 同分类的相关文章（最多 3 篇）
const all = await getAllPosts();
const related = all
  .filter((p) => p.data.slug !== data.slug && (p.data.category === data.category || p.data.tags.some((t) => data.tags.includes(t))))
  .slice(0, 3);

const path = `/posts/${data.slug}/`;
---

<BaseLayout
  title={data.title}
  description={data.summary}
  canonicalPath={path}
  ogType="article"
  ogImage={data.cover}
  article={true}
  postId={data.slug}
  jsonLd={[
    articleJsonLd(post, path),
    breadcrumbJsonLd([
      { name: '首页', path: '/' },
      { name: '文章', path: '/posts/' },
      { name: data.title, path },
    ]),
  ]}
>
  <div class="wrap post-layout">
    <article>
      <header class="post-head">
        <nav class="crumb" aria-label="面包屑">
          <a href="/">首页</a>
          <span aria-hidden="true">/</span>
          <a href="/categories/">分类</a>
          <span aria-hidden="true">/</span>
          <a href={`/categories/${toSlug(data.category)}/`}>{data.category}</a>
        </nav>

        <h1>{data.title}</h1>

        <div class="post-meta">
          <span>{SITE.author.name}</span>
          <span class="sep" aria-hidden="true"></span>
          <time datetime={data.date.toISOString()}>{dateText}</time>
          {data.updated && data.updated.getTime() !== data.date.getTime() && (
            <>
              <span class="sep" aria-hidden="true"></span>
              <span>更新于 {updatedText}</span>
            </>
          )}
          <span class="sep" aria-hidden="true"></span>
          <span>{mins} 分钟阅读</span>
        </div>
      </header>

      <div class="post-body prose">
        <Content />
      </div>

      <footer class="post-foot">
        {data.tags.length > 0 && (
          <div>
            <div class="label">标签</div>
            <div class="tags">
              {data.tags.map((t) => <a class="tag" href={`/tags/${toSlug(t)}/`}>{t}</a>)}
            </div>
          </div>
        )}

        <div class="author-box">
          <div class="avatar" aria-hidden="true">x</div>
          <div>
            <div class="who">
              {SITE.author.name} ·{' '}
              {SITE.author.census ? (
                <a
                  href={SITE.author.census}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="OpenJDK Census 名册：JDK 与 JDK Updates 项目的 Author"
                >{SITE.author.jobTitle}<span class="who-ext" aria-hidden="true">↗</span></a>
              ) : (
                SITE.author.jobTitle
              )}
            </div>
            <div class="bio">{SITE.author.description}</div>
          </div>
        </div>
      </footer>
    </article>

    <aside class="rail" aria-label="文章辅助信息">
      {toc.length >= 2 && (
        <nav class="toc" aria-label="本文目录">
          <div class="toc-title">本文目录</div>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="rail-card">
        <img
          src="/media/wechat-qr.png"
          alt="公众号二维码：肥宅英短"
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
        />
        <div class="rc-body">
          <div class="rc-name">公众号 · 肥宅英短</div>
          <div class="rc-desc">JVM 诊断与性能排查的实操长文</div>
        </div>
      </div>
    </aside>

    {related.length > 0 && (
      <section class="related">
        <div class="sec-head">
          <h2>相关文章</h2>
        </div>
        <div class="grid grid-3">
          {related.map((p) => (
            <a class="card" href={`/posts/${p.data.slug}/`}>
              <span class="cat">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <div class="meta">
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date).replace(/\//g, '-')}</time>
                <span class="dot" aria-hidden="true"></span>
                <span>{readingMinutes(p)} 分钟</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* 正文 + 右侧辅助栏。大屏才开两栏，小屏收成单栏 */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 268px;
    gap: 64px;
    align-items: start;
  }
  .post-layout > article { min-width: 0; }
  .post-layout > .related { grid-column: 1 / -1; }

  .rail {
    position: sticky;
    top: 86px;
    padding-top: 46px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-title {
    font-size: 11px;
    font-weight: 660;
    letter-spacing: .1em;
    color: var(--faint);
    margin-bottom: 10px;
  }
  .toc ol {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }
  .toc li a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 13px;
    border-left: 2px solid transparent;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    transition: color .16s var(--ease), border-color .16s var(--ease);
  }
  .toc li.d3 a { padding-left: 25px; font-size: 12.5px; }
  .toc li a:hover { color: var(--ink); }
  .toc li a.active { color: var(--accent); border-left-color: var(--accent); }

  .rail-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--surface-2);
  }
  .rail-card img {
    width: 64px;
    height: 64px;
    flex: none;
    border-radius: 8px;
  }
  .rc-name { font-size: 13px; font-weight: 650; color: var(--ink); }
  .rc-desc { font-size: 11.5px; color: var(--muted); line-height: 1.5; margin-top: 3px; }

  @media (max-width: 1080px) {
    .post-layout { grid-template-columns: 1fr; gap: 0; }
    .rail { display: none; }
  }

  .related {
    padding: 46px 0 60px;
    border-top: 1px solid var(--line-2);
    margin-top: 40px;
  }

  .post-head { max-width: 820px; }
</style>

<script>
  // 目录随滚动高亮当前章节。纯原生，无依赖。
  const links = Array.from(document.querySelectorAll('.toc a'));
  if (links.length) {
    const items = links
      .map((link) => {
        const href = link.getAttribute('href') || '';
        const el = href.startsWith('#') ? document.getElementById(href.slice(1)) : null;
        return el ? { link, el } : null;
      })
      .filter(Boolean);

    let ticking = false;
    const update = () => {
      ticking = false;
      if (!items.length) return;
      let current = items[0];
      for (const item of items) {
        if (item.el.getBoundingClientRect().top <= 96) current = item;
      }
      for (const item of items) {
        item.link.classList.toggle('active', item === current);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
