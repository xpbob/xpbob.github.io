---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT } from '../lib/site';
import { breadcrumbJsonLd } from '../lib/seo';

const expect = [
  { t: '从真实问题出发', d: '不写"什么是 GC"这类百科。每篇都对应一次线上告警或一个具体的疑难现象。' },
  { t: '给出可复现路径', d: '命令、参数、观测指标写清楚。你照着敲，能得到和我一样的数据。' },
  { t: '标注环境版本', d: 'JDK 版本、内核版本、GC 收集器会显著影响结论，文章里都会注明。' },
  { t: '非侵入式诊断优先', d: '能用 JFR / perf / /proc 观察的，绝不要求改业务代码加日志。' },
];

const topics = [
  { t: 'JVM 内存与 GC', d: 'G1 / ZGC 行为、物理内存与堆的关系、百 G 堆泄漏定位、GC crash 场景还原。' },
  { t: 'CPU 与采样分析', d: 'JFR ExecutionSample、perf、火焰图（含 GPU/CPU 混合火焰图）、频率与采样偏差。' },
  { t: '系统级观测', d: 'eBPF、glibc、伪共享、内核参数对 Java 进程的实际影响。' },
  { t: '框架与中间件排障', d: 'Flink TaskManager 等分布式组件的疑难问题与内存行为。' },
];
---

<BaseLayout
  title="关于"
  description="xpbob：OpenJDK Author，专注软件问题诊断。JVM 内存与 GC、CPU 与采样分析、eBPF 系统级观测。"
  canonicalPath="/about/"
  jsonLd={[
    breadcrumbJsonLd([
      { name: '首页', path: '/' },
      { name: '关于', path: '/about/' },
    ]),
  ]}
>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <span>关于</span>
      </nav>
      <h1>关于我</h1>
    </header>

    <div class="about">
      <section class="intro">
        <div class="avatar-lg" aria-hidden="true">x</div>
        <div>
          <h2>{SITE.author.name}</h2>
          <p class="role">
            {SITE.author.census ? (
              <a
                href={SITE.author.census}
                target="_blank"
                rel="noopener noreferrer"
                title="OpenJDK Census 名册"
              >{SITE.author.jobTitle}<span class="role-ext" aria-hidden="true">↗</span></a>
            ) : (
              SITE.author.jobTitle
            )}
          </p>
          <p class="bio">{SITE.author.description}</p>
          {SITE.author.census && (
            <p class="credential">
              OpenJDK Census 名册登记：<strong>JDK</strong> 与 <strong>JDK Updates</strong> 项目的 Author。
              <a href={SITE.author.census} target="_blank" rel="noopener noreferrer">核对名册</a>
            </p>
          )}
        </div>
      </section>

      <section>
        <h2 class="h">这个博客写什么</h2>
        <div class="grid grid-2">
          {topics.map((x) => (
            <div class="block">
              <h3>{x.t}</h3>
              <p>{x.d}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="h">你可以期待什么</h2>
        <div class="grid grid-2">
          {expect.map((x) => (
            <div class="block">
              <h3>{x.t}</h3>
              <p>{x.d}</p>
            </div>
          ))}
        </div>
      </section>

      {(CONTACT.wechat.qr || CONTACT.wechat.name || CONTACT.bilibili.href) && (
        <section>
          <h2 class="h">找到我</h2>
          <div class="contact-card">
            {CONTACT.wechat.qr && (
              <img
                class="cc-qr"
                src={CONTACT.wechat.qr}
                alt={CONTACT.wechat.name ? `${CONTACT.wechat.name} 公众号二维码` : '微信公众号二维码'}
                width="112"
                height="112"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="cc-main">
              {CONTACT.wechat.name && (
                <>
                  <div class="cc-title">微信公众号 · {CONTACT.wechat.name}</div>
                  <p class="cc-desc">{CONTACT.wechat.desc}</p>
                  <p class="cc-sub">微信扫码，或搜一搜「{CONTACT.wechat.name}」</p>
                </>
              )}
              {CONTACT.bilibili.href && (
                <a
                  class="cc-bili"
                  href={CONTACT.bilibili.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {CONTACT.bilibili.label} →
                </a>
              )}
            </div>
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 820px;
    padding: 34px 0 60px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .intro {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .avatar-lg {
    width: 68px;
    height: 68px;
    border-radius: 20px;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 700;
    font-size: 26px;
    box-shadow: var(--shadow-glow);
  }

  .intro h2 { font-size: 22px; font-weight: 750; letter-spacing: -.02em; margin-bottom: 3px; }
  .intro .role { font-size: 13.5px; color: var(--accent); font-weight: 600; margin-bottom: 11px; }
  .intro .role a { text-decoration: none; border-bottom: 1px dashed var(--accent-line); }
  .intro .role a:hover { color: var(--accent-2); border-bottom-color: var(--accent-2); }
  .intro .role-ext { font-size: 10px; opacity: .65; margin-left: 2px; }
  .intro .bio { color: var(--muted); font-size: 14.5px; }

  .credential {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.65;
    margin-top: 9px;
  }

  .credential strong { color: var(--ink-2); font-weight: 600; }
  .credential a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-line); }
  .credential a:hover { color: var(--accent-2); border-bottom-color: var(--accent-2); }

  .h {
    font-size: 17px;
    font-weight: 750;
    letter-spacing: -.018em;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .h::before {
    content: "";
    width: 3px;
    height: 16px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
  }

  .block {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 17px 19px;
  }

  .block h3 { font-size: 14.5px; font-weight: 700; margin-bottom: 6px; letter-spacing: -.012em; }
  .block p { font-size: 13.5px; color: var(--muted); line-height: 1.65; }

  /* ---- 找到我 ---- */
  .contact-card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 20px;
  }

  .cc-qr {
    width: 112px;
    height: 112px;
    flex: none;
    padding: 6px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: #fff;
    object-fit: contain;
  }

  .cc-main { min-width: 0; }

  .cc-title { font-size: 15px; font-weight: 700; letter-spacing: -.012em; margin-bottom: 5px; }
  .cc-desc { font-size: 13.5px; color: var(--muted); line-height: 1.6; }
  .cc-sub { font-size: 12.5px; color: var(--muted); margin-top: 2px; }

  .cc-bili {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    border-bottom: 1px solid var(--accent-line);
    padding-bottom: 1px;
  }

  .cc-bili:hover { color: var(--accent-2); border-color: var(--accent-2); }

  @media (max-width: 640px) {
    .intro { flex-direction: column; gap: 14px; }
    .contact-card { flex-direction: column; align-items: flex-start; gap: 15px; padding: 17px; }
  }
</style>
