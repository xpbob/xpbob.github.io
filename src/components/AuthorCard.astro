---
/**
 * 作者名片：首屏右侧的「我是谁 + 怎么找到我」。
 *
 * 数据全部来自 site.ts 的 SITE.author 与 CONTACT，页面里不写死任何文案，
 * 改配置即全站生效。三块内容（简介 / 公众号 / 视频）都是可选的：
 * 公众号没配二维码时降级成「微信搜一搜」文字引导，B 站没配链接则整块不渲染
 * —— 这样素材没到位时不会出现空壳或破图。
 */
import { SITE, CONTACT } from '../lib/site';

const { wechat, bilibili } = CONTACT;

const hasWechat = Boolean(wechat.qr || wechat.name);
const hasBilibili = Boolean(bilibili.href);

/** 头像位暂用首字母：换成真实头像时把下面 div 换成 <img> 即可（样式已兼容） */
const initial = SITE.author.name.slice(0, 1).toUpperCase();
---

<aside class="author-card" aria-label="作者与联系方式">
  <div class="ac-top">
    <div class="ac-ava" aria-hidden="true">{initial}</div>
    <div>
      <div class="ac-name">{SITE.author.name}</div>
      {SITE.author.census ? (
        <a
          class="ac-role ac-role-link"
          href={SITE.author.census}
          target="_blank"
          rel="noopener noreferrer"
          title="OpenJDK Census 名册：JDK 与 JDK Updates 项目的 Author"
        >{SITE.author.jobTitle}<span class="ac-role-ext" aria-hidden="true">↗</span></a>
      ) : (
        <div class="ac-role">{SITE.author.jobTitle}</div>
      )}
    </div>
  </div>

  <p class="ac-bio">{SITE.author.description}</p>

  <div class="ac-sec">
    <div class="ac-label">擅长</div>
    <div class="ac-tags">
      {SITE.author.knowsAbout.slice(0, 4).map((t) => <span class="ac-tag">{t}</span>)}
    </div>
  </div>

  {hasWechat && (
    <div class="ac-sec">
      <div class="ac-label">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8.7 3C4.9 3 1.8 5.6 1.8 8.8c0 1.8 1 3.4 2.6 4.5l-.7 2.1 2.4-1.2c.8.2 1.7.3 2.6.3h.5a5.6 5.6 0 0 1-.2-1.5c0-3.1 3-5.6 6.7-5.6h.5C15.6 4.9 12.5 3 8.7 3Zm-2.4 3.1a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Zm4.8 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z"/>
          <path d="M22.2 13c0-2.7-2.7-4.9-5.9-4.9s-5.9 2.2-5.9 4.9 2.7 4.9 5.9 4.9c.7 0 1.4-.1 2-.3l2 1-.6-1.7c1.5-.9 2.5-2.3 2.5-3.9Zm-7.9-1.5a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6Zm4 0a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6Z"/>
        </svg>
        微信公众号
      </div>

      {wechat.qr ? (
        <div class="ac-wx">
          <img
            class="ac-qr"
            src={wechat.qr}
            alt={wechat.name ? `${wechat.name} 公众号二维码` : '微信公众号二维码'}
            width="88"
            height="88"
            loading="lazy"
            decoding="async"
          />
          <div class="ac-wx-main">
            {wechat.name && <div class="ac-wx-name">{wechat.name}</div>}
            <p class="ac-wx-desc">{wechat.desc}</p>
            <span class="ac-wx-hint">扫码或搜一搜</span>
          </div>
        </div>
      ) : (
        <div class="ac-wx-plain">
          <span>微信搜索</span>
          <b>{wechat.name}</b>
          <span class="kbd">搜一搜</span>
        </div>
      )}
    </div>
  )}

  {hasBilibili && (
    <div class="ac-sec">
      <div class="ac-label">视频</div>
      <a class="ac-bili" href={bilibili.href} target="_blank" rel="noopener noreferrer">
        <span class="ac-bili-ico" aria-hidden="true"></span>
        <span class="ac-bili-main">
          <span class="ac-bili-name">{bilibili.label}</span>
          {bilibili.desc && <span class="ac-bili-desc">{bilibili.desc}</span>}
        </span>
      </a>
    </div>
  )}
</aside>
