<div class="sbox" id="sbox" data-index="/search-index.json">
  <button
    class="sbox-trigger"
    type="button"
    aria-haspopup="dialog"
    aria-controls="sbox-dialog"
    aria-label="站内搜索"
    title="站内搜索（按 / 打开）"
  >
    <svg class="sbox-ico" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
      <circle cx="8.6" cy="8.6" r="5.3"></circle>
      <path d="M12.6 12.6 16.2 16.2"></path>
    </svg>
    <span class="sbox-trigger-txt">搜索</span>
    <kbd class="sbox-kbd">/</kbd>
  </button>

  <dialog class="sbox-dialog" id="sbox-dialog" aria-label="站内搜索">
    <div class="sbox-panel">
      <div class="sbox-field">
        <svg class="sbox-ico" viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
          <circle cx="8.6" cy="8.6" r="5.3"></circle>
          <path d="M12.6 12.6 16.2 16.2"></path>
        </svg>
        <input
          class="sbox-input"
          id="sbox-input"
          type="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="sbox-list"
          aria-autocomplete="list"
          aria-describedby="sbox-status"
          placeholder="搜索标题、正文、标签…"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button class="sbox-esc" type="button" data-sbox-close>Esc</button>
      </div>

      <p class="sbox-status" id="sbox-status" role="status" aria-live="polite">输入关键词开始检索</p>

      <ul class="sbox-list" id="sbox-list" role="listbox" aria-label="搜索结果"></ul>

      <div class="sbox-foot">
        <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
        <span><kbd>↵</kbd> 打开</span>
        <span><kbd>esc</kbd> 关闭</span>
        <span class="sbox-foot-note">检索标题、正文与标签</span>
      </div>
    </div>
  </dialog>
</div>

<script>
  /* 站内搜索的交互层。匹配规则在 lib/search-core.js（可脱离浏览器测试），
     索引是构建期产出的 /search-index.json，首次打开时才拉，约 20KB（gzip）。 */
  import { search, snippetOf, mergeMatchRanges } from '../lib/search-core.js';

  (function () {
    var root = document.getElementById('sbox');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    var dialog = root.querySelector('.sbox-dialog');
    var panel = root.querySelector('.sbox-panel');
    var input = root.querySelector('.sbox-input');
    var list = root.querySelector('.sbox-list');
    var status = root.querySelector('.sbox-status');
    var trigger = root.querySelector('.sbox-trigger');
    var INDEX_URL = root.dataset.index || '/search-index.json';

    var docs = null;      // null = 尚未加载
    var pending = null;   // 加载中的 Promise
    var failed = false;
    var active = -1;      // 当前高亮项
    var lastFocus = null;

    var MAX_ITEMS = 12;
    var IDLE_ITEMS = 5;

    function loadIndex() {
      if (pending) return pending;
      pending = fetch(INDEX_URL, { credentials: 'omit' })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (json) {
          docs = Array.isArray(json && json.docs) ? json.docs : [];
          return docs;
        })
        .catch(function (err) {
          failed = true;
          pending = null; // 下次打开允许重试
          throw err;
        });
      return pending;
    }

    /* ── 渲染 ───────────────────────────────────────────── */

    function el(tag, cls) {
      var node = document.createElement(tag);
      if (cls) node.className = cls;
      return node;
    }

    function clear(node) {
      while (node.firstChild) node.removeChild(node.firstChild);
    }

    /** 写入 text 并把命中词包成 <mark>（纯 DOM 拼装，不拼 HTML 串，天然免疫注入） */
    function appendHighlighted(parent, text, terms) {
      var ranges = mergeMatchRanges(text, terms);
      if (!ranges.length) {
        parent.appendChild(document.createTextNode(text));
        return;
      }

      var cursor = 0;
      ranges.forEach(function (r) {
        if (r[0] > cursor) parent.appendChild(document.createTextNode(text.slice(cursor, r[0])));
        var mark = document.createElement('mark');
        mark.textContent = text.slice(r[0], r[1]);
        parent.appendChild(mark);
        cursor = r[1];
      });
      if (cursor < text.length) parent.appendChild(document.createTextNode(text.slice(cursor)));
    }

    function renderItem(doc, terms, index, entry) {
      var li = el('li', 'sbox-item');
      li.setAttribute('role', 'presentation');

      var a = el('a', 'sbox-hit');
      a.href = doc.u;
      a.id = 'sbox-o-' + index;
      a.setAttribute('role', 'option');
      a.setAttribute('aria-selected', 'false');
      a.dataset.index = String(index);

      var top = el('span', 'sbox-hit-top');
      var cat = el('span', 'sbox-hit-cat');
      cat.textContent = doc.c || '';
      top.appendChild(cat);

      var title = el('span', 'sbox-hit-title');
      appendHighlighted(title, doc.t || '', terms);
      top.appendChild(title);
      a.appendChild(top);

      // entry 是检索命中的那一条；「最近发布」没有命中位置，退回摘要
      var snip = snippetOf(doc, entry || { pos: -1 });
      if (snip) {
        var p = el('span', 'sbox-hit-snip');
        if (snip.lead) p.appendChild(document.createTextNode('…'));
        appendHighlighted(p, snip.text, terms);
        if (snip.tail) p.appendChild(document.createTextNode('…'));
        a.appendChild(p);
      }

      var meta = el('span', 'sbox-hit-meta');
      meta.textContent = (doc.d || '') + (doc.m ? ' · ' + doc.m + ' 分钟' : '');
      a.appendChild(meta);

      li.appendChild(a);
      return li;
    }

    function renderList(entries, terms, emptyText) {
      clear(list);
      active = -1;
      input.setAttribute('aria-expanded', entries.length ? 'true' : 'false');
      input.removeAttribute('aria-activedescendant');

      if (!entries.length) {
        var tip = el('li', 'sbox-empty');
        tip.textContent = emptyText;
        list.appendChild(tip);
        return;
      }

      var frag = document.createDocumentFragment();
      entries.forEach(function (entry, i) {
        // entry 即检索结果本身（含 doc / pos / score）；「最近发布」用 pos=-1 占位
        frag.appendChild(renderItem(entry.doc, terms, i, entry));
      });
      list.appendChild(frag);
    }

    function setActive(next) {
      var items = list.querySelectorAll('.sbox-hit');
      if (!items.length) return;
      if (next < 0) next = items.length - 1;
      if (next >= items.length) next = 0;

      if (active >= 0 && items[active]) {
        items[active].classList.remove('is-active');
        items[active].setAttribute('aria-selected', 'false');
      }
      active = next;
      var node = items[active];
      node.classList.add('is-active');
      node.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', node.id);

      if (node.scrollIntoView) {
        try { node.scrollIntoView({ block: 'nearest' }); } catch (e) { /* 老浏览器忽略 */ }
      }
    }

    function renderIdle() {
      var entries = (docs || []).slice(0, IDLE_ITEMS).map(function (doc) {
        return { doc: doc, pos: -1 };
      });
      status.textContent = '最近发布 · 共 ' + (docs || []).length + ' 篇';
      renderList(entries, [], '还没有文章');
    }

    function renderError() {
      status.textContent = '索引加载失败，请刷新页面重试';
      renderList([], [], '暂时无法检索');
    }

    function run(q) {
      if (!docs) {
        if (failed) { renderError(); return; }
        status.textContent = '正在加载索引…';
        loadIndex()
          .then(function () { run(q); })
          .catch(renderError);
        return;
      }

      if (!q) { renderIdle(); return; }

      var res = search(docs, q, MAX_ITEMS);
      if (!res || !res.items.length) {
        status.textContent = '没有匹配「' + q + '」的文章';
        renderList([], [], '换个更短的关键词试试，比如只搜一个词');
        return;
      }

      status.textContent = '找到 ' + res.items.length + ' 篇' + (res.loose ? '（部分匹配）' : '');
      renderList(res.items, res.terms, '');
    }

    /* ── 开关 ───────────────────────────────────────────── */

    function openDialog() {
      if (dialog.open) return;
      lastFocus = document.activeElement;
      document.documentElement.classList.add('sbox-lock');
      try {
        dialog.showModal();
      } catch (e) {
        return;
      }
      input.value = '';
      active = -1;
      input.focus();
      run('');
    }

    function closeDialog() {
      if (dialog.open) dialog.close();
    }

    dialog.addEventListener('close', function () {
      document.documentElement.classList.remove('sbox-lock');
      // 从快捷键唤起时焦点本来在 body 上，退回到搜索按钮更顺手
      var back = lastFocus && lastFocus !== document.body ? lastFocus : trigger;
      if (back && typeof back.focus === 'function') {
        try { back.focus({ preventScroll: true }); } catch (e) { back.focus(); }
      }
    });

    // Esc 显式处理：原生 cancel 已能关，但显式接管后行为可控、可测，
    // 也不会因为 preventDefault 之外的原因在部分环境里漏关
    dialog.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDialog();
      }
    });

    // 点遮罩关闭（panel 之外即遮罩）
    dialog.addEventListener('click', function (e) {
      if (!panel.contains(e.target)) closeDialog();
    });

    trigger.addEventListener('click', openDialog);
    var closeBtn = root.querySelector('[data-sbox-close]');
    if (closeBtn) closeBtn.addEventListener('click', closeDialog);

    // 悬停/聚焦即预取索引，真正打开时不用等
    function prefetch() {
      if (!docs && !failed) loadIndex().catch(function () { /* 打开时再报错 */ });
    }
    trigger.addEventListener('pointerenter', prefetch, { once: true });
    trigger.addEventListener('focus', prefetch, { once: true });

    /* ── 交互 ───────────────────────────────────────────── */

    var timer = null;
    input.addEventListener('input', function () {
      var q = input.value.trim();
      clearTimeout(timer);
      timer = setTimeout(function () { run(q); }, 90);
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active < 0 ? 0 : active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active < 0 ? -1 : active - 1);
      } else if (e.key === 'Enter') {
        var target = list.querySelector(active >= 0 ? '.sbox-hit.is-active' : '.sbox-hit');
        if (target) {
          e.preventDefault();
          target.click();
        }
      }
    });

    list.addEventListener('mousemove', function (e) {
      var hit = e.target.closest ? e.target.closest('.sbox-hit') : null;
      if (!hit) return;
      var idx = Number(hit.dataset.index);
      if (!isNaN(idx) && idx !== active) setActive(idx);
    });

    // ⌘K / Ctrl+K 开关；不在输入框里按 / 也能唤起
    document.addEventListener('keydown', function (e) {
      var key = e.key;
      if ((e.metaKey || e.ctrlKey) && (key === 'k' || key === 'K')) {
        e.preventDefault();
        if (dialog.open) closeDialog();
        else openDialog();
        return;
      }
      if (key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        var t = e.target;
        var tag = t && t.tagName ? t.tagName.toLowerCase() : '';
        if (tag === 'input' || tag === 'textarea' || tag === 'select' || (t && t.isContentEditable)) return;
        e.preventDefault();
        openDialog();
      }
    });
  })();
</script>
